    "episode_list": [
      {
        "episode_number": 1,
        "title": "There was never an instance where the tuning matched. I have come to think that there exists a better spot out there.",
        "aired": "Oct 3, 2009",
        "filler": false,
        "recap": false
      },
      {
        "episode_number": 2,
        "title": "The things hidden from view are destroying everything around it. Since it was never there, nothing can be done to deal with it.",
        "aired": "Oct 10, 2009",
        "filler": false,
        "recap": false
      },
      {
        "episode_number": 3,
        "title": "I do writhe in embarrassment when I reminisce my childhood. Moreover so if I make comparisons.",
        "aired": "Oct 17, 2009",
        "filler": false,
        "recap": false
      },
      {
        "episode_number": 4,
        "title": "I have lies that I want to expose. I have truths that I do not wish to believe. I have one of these each.",
        "aired": "Oct 24, 2009",
        "filler": false,
        "recap": false
      },
      {
        "episode_number": 5,
        "title": "Aren't you taking too much for granted? Complaining that you are claustrophobic while you are hiding in your own shell.",
        "aired": "Oct 31, 2009",
        "filler": false,
        "recap": false
      },
      {
        "episode_number": 6,
        "title": "I move on as I am losing interest. Most of the time though, I seem to have already lost interest before I move on.",
        "aired": "Nov 7, 2009",
        "filler": false,
        "recap": false
      },
      {
        "episode_number": 7,
        "title": "Love is beyond reason. Lovers who say this to one another are poets, critics, philosophers.",
        "aired": "Nov 14, 2009",
        "filler": false,
        "recap": false
      },
      {
        "episode_number": 8,
        "title": "I think I want to return to the crossroad. Would have been better if I had chosen the right one. That journey filled only with regret.",
        "aired": "Nov 21, 2009",
        "filler": false,
        "recap": false
      },
      {
        "episode_number": 9,
        "title": "Having troubles expressing yourself? Try to strike a conversation with your eyes and you'll soon find yourself in the mood for a chat.",
        "aired": "Nov 28, 2009",
        "filler": false,
        "recap": false
      },
      {
        "episode_number": 10,
        "title": "I have come to desire catching a cold in anticipation of the nursing and the home-cooked dishes. I didn't include the later part suffering in my imagination at all.",
        "aired": "Dec 5, 2009",
        "filler": false,
        "recap": false
      },
      {
        "episode_number": 11,
        "title": "Nightfall did not bring about anything at all. It was the fault of the sun that the colors faded.",
        "aired": "Dec 12, 2009",
        "filler": false,
        "recap": false
      },
      {
        "episode_number": 12,
        "title": "It's the fault of others. I'm not at fault. All the fault lies in others. Only I myself am―",
        "aired": "Dec 19, 2009",
        "filler": false,
        "recap": false
      },
      {
        "episode_number": 13,
        "title": "We sit together now, and all night long we have not stirred.",
        "aired": "Dec 24, 2009",
        "filler": false,
        "recap": false
      }
    ]
